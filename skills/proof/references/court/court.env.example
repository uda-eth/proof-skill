# court.env — copy to <repo>/court.env and edit. Every court script sources it.
REFERENCE_DIR="$HOME/reference-app"     # read-only source of the thing you must match (Mac app, old version, spec repo). Empty = none.
REFERENCE_NAME="the reference app"      # how briefs and the Judge refer to it
MAIN_BRANCH="main"
BUILD_CMD="dotnet build -nodeReuse:false"          # must exit 0 on success
TEST_CMD_FOR="dotnet test --project tests/{p} --no-build"   # {p} = one test project name
JUDGE_EFFORT="high"                     # codex model_reasoning_effort
COURT_DIR="docs/court"                  # judge/ + jury/ live under here
